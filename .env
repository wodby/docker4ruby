### Documentation available at https://wodby.com/docs/1.0/stacks/ruby/local
### Changelog can be found at https://github.com/wodby/docker4ruby/releases
### Images tags format explained at https://github.com/wodby/docker4ruby#images-tags

### PROJECT SETTINGS

PROJECT_NAME=my_ruby_project
PROJECT_BASE_URL=ruby.docker.localhost

DB_NAME=ruby
DB_USER=ruby
DB_PASSWORD=ruby
DB_HOST=postgres
DB_ADAPTER=postgresql
#DB_ADAPTER=mysql2

### --- RUBY ----

# Linux (uid 1000 gid 1000)

RUBY_TAG=4.0-dev-r7
#RUBY_TAG=3.4-dev-r7
#RUBY_TAG=3.3-dev-r7

# macOS (uid 501 gid 20)

#RUBY_TAG=4.0-dev-macos-r7
#RUBY_TAG=3.4-dev-macos-r7
#RUBY_TAG=3.3-dev-macos-r7

### --- NGINX ----

NGINX_TAG=1.31-r17
#NGINX_TAG=1.30-r17

### --- NODE ---

NODE_TAG=26-dev-r12
#NODE_TAG=24-dev-r12
#NODE_TAG=22-dev-r12

### --- POSTGRESQL ----

POSTGRES_TAG=18-r3
#POSTGRES_TAG=17-r3
#POSTGRES_TAG=16-r3
#POSTGRES_TAG=15-r3
#POSTGRES_TAG=14-r3

